# Every secret and configuration name that exists. Values never enter git.
# Server names live in /opt/kl/.env on the VPS (mode 600, owner kl); GitHub names in repo secrets;
# local tool names in .env.local on the developer machine. See docs/spec/what.md §18.

# --- VPS / PocketBase (server-side only, never in GitHub) ---
# SMS_PROVIDER: kavenegar = real SMS (production) | console = prints the code to stdout and the log
# (dev/test only) | mock = sends nothing and the code is always 123456 (staging, until the SMS
# account is verified; the server warns at every boot when it runs on the real origin). Anything
# else makes /api/otp/request fail with SMS_PROVIDER_UNKNOWN.
SMS_PROVIDER=kavenegar
SMS_API_KEY=                      # Kavenegar API key (kavenegar only)
SMS_OTP_TEMPLATE=kl-otp           # Kavenegar Verify Lookup template name; one %token% (the code)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0                # 1 = use Zarinpal's sandbox endpoints
ZARINPAL_CALLBACK_URL=https://app.konkurleitner.com/api/pay/callback
PUBLIC_APP_ORIGIN=https://app.konkurleitner.com
CONTENT_DIR=/opt/kl/content       # holds paid.json + manifest.json
SOURCEMAP_DIR=/opt/kl/sourcemaps  # <buildSha>/*.map, superuser-only route
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=kl-backups
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# --- GitHub Actions secrets ---
DEPLOY_HOST=                      # VPS IP
DEPLOY_USER=kl
DEPLOY_SSH_KEY=                   # private key, deploy user
ANDROID_KEYSTORE_B64=             # base64 of the TWA signing keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=konkurleitner

# --- Web build (apps/web, apps/landing, apps/admin) ---
VITE_API_ORIGIN=https://app.konkurleitner.com
VITE_APP_NAME=کنکور لایتنر        # placeholder until the Persian name is decided (product-brief Q41)
VITE_SUPPORT_URL=                 # Telegram link shown in settings and on the landing page

# --- Local tools (.env.local, git-ignored): pnpm errors / logs / flags / deploy ---
KL_API_ORIGIN=https://admin.konkurleitner.com
KL_ADMIN_EMAIL=
KL_ADMIN_PASSWORD=

# --- One-time bootstrap (.env.local only) ---
VPS_IP=
VPS_ROOT_PASSWORD=                # used once; the kl user with a key replaces it
# DNS needs no key: it's on Parspack's CDN panel, managed by hand. See docs/runbooks/server-setup.md.
