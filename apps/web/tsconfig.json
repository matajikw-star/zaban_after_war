{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    // An app emits nothing: Vite builds it. Not composite, so it is not a `tsc --build`
    // reference; the root `typecheck` runs `pnpm -r typecheck` for apps instead.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src", "e2e", "scripts", "vite.config.ts", "playwright.config.ts"]
}
