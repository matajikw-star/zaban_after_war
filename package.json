{
  "name": "konkour-leitner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "pnpm --filter @kl/server test",
    "typecheck": "tsc --build --force && pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "pnpm -r --if-present build",
    "budget": "node tools/budget/index.mjs",
    "e2e": "pnpm --filter @kl/web e2e",
    "simulate": "node --experimental-strip-types tools/simulate/index.ts",
    "errors": "node --experimental-strip-types tools/errors/index.ts",
    "logs": "node --experimental-strip-types tools/logs/index.ts",
    "flags": "node --experimental-strip-types tools/flags/index.ts",
    "deploy": "node --experimental-strip-types tools/deploy/index.ts",
    "provision": "node --experimental-strip-types tools/deploy/provision.ts",
    "content:build": "node --experimental-strip-types tools/content-build/index.ts",
    "spec:check": "node --experimental-strip-types tools/spec-check/index.ts",
    "content:lint": "pnpm --filter @kl/content run lint:content"
  },
  "dependencies": {
    "source-map": "^0.7.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
